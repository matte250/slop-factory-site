e = \"#05050c\";\n94:       ctx.fillRect(0, 0, canvas.width, canvas.height);\n95:       // Draw player (if exists)\n96:       if (player) {\n97:         ctx.fillStyle = \"#7df9ff\";\n98:         ctx.beginPath();\n99:         ctx.arc(player.x, player.y, player.radius, 0, Math.PI * 2);\n100:         ctx.fill();\n101:       }\n102:       // Draw score HUD\n103:       ctx.fillStyle = \"#e6e6f0\";\n104:       ctx.font = \"16px ui-sans-serif, system-ui\";\n105:       ctx.textAlign = \"left\";\n106:       ctx.fillText(`Score ${score}`, 12, 22);\n107:       // Game over overlay\n108:       if (phase === \"gameover\") {\n109:         ctx.fillStyle = \"rgba(5,5,12,0.65)\";\n110:         ctx.fillRect(0, 0, canvas.width, canvas.height);\n111:         ctx.textAlign = \"center\";\n112:         ctx.font = \"44px ui-sans-serif, system-ui\";\n113:         ctx.fillStyle = \"#ff52ae\";\n114:         ctx.fillText(\"Game Over\", canvas.width / 2, canvas.height / 2 - 20);\n115:         ctx.fillStyle = \"#e6e6f0\";\n116:         ctx.font = \"20px ui-sans-serif, system-ui\";\n117:         ctx.fillText(`Final score ${score}`, canvas.width / 2, canvas.height / 2 + 14);\n118:         ctx.fillStyle = \"#a5a5b8\";\n119:         ctx.font = \"16px ui-sans-serif, system-ui\";\n120:         ctx.fillText(\"Press R or click Restart\", canvas.width / 2, canvas.height / 2 + 42);\n121:       }\n122:     }\n123: \n124:   </script>\n125: </body>\n126: </html>\n\n(End of file - total 126 lines)\n</content>","metadata":{"preview":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>Force Burst</title>\n  <style>\n    body { margin: 0; background: #0a0a0f; color: #e6e6f0; font-family: ui-sans-serif, system-ui, sans-serif; }\n    .game-header { padding: 12px 16px; border-bottom: 1px solid #1d1d2a; }\n    .game-header h1 { margin: 0; font-size: 18px; color: #7df9ff; }\n    .game-header .game-description { margin: 4px 0; color: #a5a5b8; }\n    .game-header .game-controls { margin: 