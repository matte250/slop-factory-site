rt\" class=\"game-restart\" type=\"button\">Restart</button>\n32:   </main>\n33:   <script>\n34:   // === CONFIG =============================================================\n35:   const W = 800, H = 600;\n36:   const LANE_LEFT = W / 3;\n37:   const LANE_RIGHT = (2 * W) / 3;\n38:   const SAFE_RADIUS = 80;\n39: \n40:   // === STATE ==============================================================\n41:   const canvas = document.getElementById('game');\n42:   const ctx = canvas.getContext('2d');\n43:   const restartBtn = document.getElementById('restart');\n44: \n45:   let ship;          // { x, y, vx, vy, angle, alive }\n46:   let bullets;       // placeholder array\n47:   let obstacles;     // placeholder array\n48:   let score;\n49:   let highScore = 0;\n50:   let phase;         // \"playing\" | \"gameover\"\n51:   let keys;\n52:   let split = false; // true when split into two dots\n53:   let laneShift = 0; // -1 left, 1 right, 0 none\n54:   let lastTime;\n55:   let loopId = null;\n56:   let audioCtx = null;\n57: \n58:   // === RESET ==============================================================\n59:   function reset() {\n60:     // Cancel any existing animation loop\n61:     if (loopId !== null) {\n62:       cancelAnimationFrame(loopId);\n63:       loopId = null;\n64:     }\n65:     // Reset game state\n66:     ship = { x: W/2, y: H/2, vx: 0, vy: 0, angle: 0, alive: true };\n67:     bullets = [];\n68:     obstacles = [];\n69:     split = false;\n70:     laneShift = 0;\n71:     score = 0;\n72:     phase = 'playing';\n73:     keys = new Set();\n74:     lastTime = performance.now();\n75:     publishState();\n76:     startLoop();\n77:   }\n78: \n79:   // === LOOP / UPDATE ======================================================\n80:   function startLoop() {\n81:     if (loopId !== null) cancelAnimationFrame(loopId);\n82:     function tick(now) {\n83:       try {\n84:         const dt = Math.min((now - lastTime) / 1000, 0.1);\n85:         lastTime = now;\n86:         // Clear canvas before rendering\n87:         ctx.clearRect(0, 0, W, H);\n88:         update(dt);\n89:         render();\n90:         publishState();\n91:       } catch (err) {\n92:         console.error('loop error', err);\n93:       }\n94:       loopId = requestAnimationFrame(tick);\n95:     }\n96:     loopId = requestAnimationFrame(tick);\n97:   }\n98: \n99:   function update(dt) {\n100:     // Placeholder – no game logic yet\n101:   }\n102: \n103:   // === RENDER =============================================================\n104:   function render() {\n105:     ctx.fillStyle = '#05050c';\n106:     ctx.fillRect(0, 0, W, H);\n107:     // Draw ship placeholder\n108:     if (ship && ship.alive) {\n109:       ctx.fillStyle = '#7df9ff';\n110:       ctx.beginPath();\n111:       ctx.arc(ship.x, ship.y, 8, 0, Math.PI * 2);\n112:       ctx.fill();\n113:     }\n114:   }\n115: \n116:   // === INPUT ==============================================================\n117:   document.addEventListener('keydown', (ev) => {\n118:     if (ev.key === 'r' || ev.key === 'R') { reset(); return; }\n119:     keys.add(ev.key);\n120:   });\n121:   document.addEventListener('keyup', (ev) => { keys.delete(ev.key); });\n122:   restartBtn.addEventListener('click', reset);\n123: \n124:   // === AUDIO (lazy) ======================================================\n125:   function beep(freq, durSec) {\n126:     try {\n127:       if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();\n128:       const osc = audioCtx.createOscillator();\n129:       const gain = audioCtx.createGain();\n130:       osc.type = 'triangle';\n131:       osc.frequency.value = freq;\n132:       gain.gain.setValueAtTime(0.04, audioCtx.currentTime);\n133:       gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + durSec);\n134:       osc.connect(gain); gain.connect(audioCtx.destination);\n135:       osc.start();\n136:       osc.stop(audioCtx.currentTime + durSec);\n137:     } catch {}\n138:   }\n139: \n140:   // === OBSERVABLE CONTRACT ===============================================\n141:   function publishState() {\n142:     window.__game = {\n143:       state: phase,\n144:       score: score,\n145:       player: {\n146:         x: ship ? ship.x : 0,\n147:         y: ship ? ship.y : 0,\n148:         visible: ship ? (ship.x >= 0 && ship.x < W && ship.y >= 0 && ship.y < H) : false,\n149:       },\n150:       objective: 'Tap to split and merge the dot while avoiding obstacles.',\n151:     };\n152:   }\n153: \n154:   // === HELPERS ===========================================================\n155:   function wrap(v, max) {\n156:     if (v < 0) return v + max;\n157:     if (v >= max) return v - max;\n158:     return v;\n159:   }\n160: \n161:   // === BOOT ===============================================================\n162:   reset();\n163:   </script>\n164: </body>\n165: </html>\n\n(End of file - total 165 lines)\n</content>","metadata":{"preview":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>Split Path</title>\n  <style>\n    body { margin: 0; background: #0a0a0f; color: #e6e6f0; font-family: ui-sans-serif, system-ui, sans-serif; }\n    .game-header { padding: 12px 16px; border-bottom: 1px solid #1d1d2a; }\n    .game-header h1 { margin: 0; font-size: 18px; color: #7df9ff; }\n    .game-header .game-description { margin: 4px 0; color: #a5a5b8; }\n    .game-header .game-controls { margin: 4px 0; padding-left: 18px; color: #c8c8d8; }\n    main { display: flex; flex-direction: column; align-items: center; padding: 16px; }\n    canvas { background: #05050c; border: 1px solid #2a2f44; }\n    .game-restart { margin-top: 10px; padding: 8px 14px; background: #1c2030; color: #7df9ff; border: 1px solid #2a2f44; cursor: pointer; }\n    .game-restart:hover { background: #232842; }\n  </style>\n</head>\n<body>\n  <header class=\"game-header\">\n    <h1>Split Path</h1>","truncated":false,"loaded":[]},"title":"tmp/slop-factory-work/sp