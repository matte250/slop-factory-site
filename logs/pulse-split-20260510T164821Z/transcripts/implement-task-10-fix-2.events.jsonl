re game state objects\n34:   const canvas = document.getElementById('game');\n35:   const ctx = canvas.getContext('2d');\n36:   const W = canvas.width;\n37:   const H = canvas.height;\n38:   const PLAYER_RADIUS = 8;\n39:   const PLAYER_ACCEL = 200; // px/sec^2\n40:   const PLAYER_FRICTION = 0.8; // per second decay\n41:   const PLAYER_MAX_SPEED = 300;\n42:   const HAZARD_RADIUS = 10;\n43:   const HAZARD_SPEED_MIN = 50;\n44:   const HAZARD_SPEED_MAX = 150;\n45:   const SAFE_RADIUS_AT_SPAWN = 120; // avoid spawning too close to player start\n46:   const player = { x: W/2, y: H/2, vx: 0, vy: 0, angle: 0, visible: true };\n47:   const hazards = []; // array of hazard objects\n48:   let score = 0;\n49:   let highScore = 0;\n50:   let phase = \"waiting\"; // \"waiting\" | \"playing\" | \"gameover\"\n51:   // Additional state will be added in later tasks\n52: \n53:   // === LOOP ==============================================================\n54:   let loopId = null;\n55:   let lastTime = performance.now();\n56: function startLoop() {\n57:     if (loopId !== null) cancelAnimationFrame(loopId);\n58:     function tick(now) {\n59:       try {\n60:         const dt = Math.min((now - lastTime) / 1000, 0.1);\n61:         lastTime = now;\n62:         update(dt);\n63:         render();\n64:       } catch (err) {\n65:         console.error(\"loop error\", err);\n66:       }\n67:       loopId = requestAnimationFrame(tick);\n68:     }\n69:     loopId = requestAnimationFrame(tick);\n70:   }\n71: \n72:   function update(dt) {\n73:     if (phase !== 'playing') return;\n74:     // Rotation\n75:     const turn = (keys.has('ArrowRight') || keys.has('d') || keys.has('D') ? 1 : 0) -\n76:                  (keys.has('ArrowLeft')  || keys.has('a') || keys.has('A') ? 1 : 0);\n77:     const TURN_SPEED = Math.PI * 2; // rad per second\n78:     player.angle += turn * TURN_SPEED * dt;\n79:     // Acceleration\n80:     const thrust = keys.has('ArrowUp') || keys.has('w') || keys.has('W');\n81:     if (thrust) {\n82:       player.vx += Math.cos(player.angle) * PLAYER_ACCEL * dt;\n83:       player.vy += Math.sin(player.angle) * PLAYER_ACCEL * dt;\n84:       // Apply friction\n85:     const decay = Math.pow(PLAYER_FRICTION, dt);\n86:     player.vx *= decay;\n87:     player.vy *= decay;\n88:     // Clamp speed\n89:     const speed = Math.hypot(player.vx, player.vy);\n90:     if (speed > PLAYER_MAX_SPEED) {\n91:       const scale = PLAYER_MAX_SPEED / speed;\n92:       player.vx *= scale;\n93:       player.vy *= scale;\n94:       // Update position with wrap\n95:     player.x = (player.x + player.vx * dt + W) % W;\n96:     player.y = (player.y + player.vy * dt + H) % H;\n97:     player.visible = true;\n98:     // Hazards motion\n99:     for (const h of hazards) {\n100:       h.x = (h.x + h.vx * dt + W) % W;\n101:       h.y = (h.y + h.vy * dt + H) % H;\n102:       // Collision detection\n103:     for (const h of hazards) {\n104:       if (Math.hypot(player.x - h.x, player.y - h.y) < PLAYER_RADIUS + h.r) {\n105:         phase = 'gameover';\n106:         console.log('game over');\n107:         break;\n108:       \n109:   function spawnHazard() {\n110:     // spawn at random edge position\n111:     const edge = Math.floor(Math.random() * 4);\n112:     let x, y, dirAngle;\n113:     if (edge === 0) { x = 0; y = Math.random()*H; dirAngle = 0; }\n114:     else if (edge === 1) { x = W; y = Math.random()*H; dirAngle = Math.PI; }\n115:     else if (edge === 2) { x = Math.random()*W; y = 0; dirAngle = Math.PI/2; }\n116:     else { x = Math.random()*W; y = H; dirAngle = -Math.PI/2; }\n117:     const speed = HAZARD_SPEED_MIN + Math.random()*(HAZARD_SPEED_MAX-HAZARD_SPEED_MIN);\n118:     const vx = Math.cos(dirAngle)*speed;\n119:     const vy = Math.sin(dirAngle)*speed;\n120:     // ensure safe radius from player start (center)\n\n(Showing lines 1-120 of 182. Use offset=121 to continue.)\n</content>","metadata":{"preview":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=