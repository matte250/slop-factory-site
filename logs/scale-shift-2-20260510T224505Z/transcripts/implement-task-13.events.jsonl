========================================\n33:     // Game constants\n34:     const PLAYER_RADIUS_SMALL = 5;\n35:     const PLAYER_RADIUS_LARGE = 12;\n36:     const SAFE_RADIUS = 200;\n37:     const GAP_SMALL = PLAYER_RADIUS_SMALL; // gap size for small radius\n38:     const GAP_LARGE = PLAYER_RADIUS_LARGE; // gap size for large radius\n39:     const PLAYER_SPEED = 200; // forward speed in px/sec\n40: \n41:     // === STATE =============================================================\n42:     const canvas = document.getElementById('game');\n43:     const ctx = canvas.getContext('2d');\n44:     const restartBtn = document.getElementById('restart');\n45:     let loopId = null;\n46:     let keys = new Set();\n47:     let audioCtx = null;\n48:     // Game state variables\n49:     let player = { x: canvas.width/2, y: canvas.height/2, radius: PLAYER_RADIUS_SMALL, targetRadius: PLAYER_RADIUS_SMALL, visible: true };\n50:     let hazards = [];\n51:     let score = 0;\n52:     let phase = \"menu\"; // \"menu\" | \"playing\" | \"gameover\"\n53:     let lastTime = performance.now();\n54:     let spawnTimer = 0;\n55: \n56:     // === RESET =============================================================\n57:     function reset() {\n58:       // Initialize or reinitialize game state\n59:       player.x = canvas.width/2;\n60:       player.y = canvas.height/2;\n61:       player.radius = PLAYER_RADIUS_SMALL;\n62:       player.targetRadius = PLAYER_RADIUS_SMALL;\n63:       player.visible = true;\n64:       hazards = [];\n65:       score = 0;\n66:       phase = \"playing\";\n67:       // Clear canvas\n68:       ctx.clearRect(0, 0, canvas.width, canvas.height);\n69:       // Draw player placeholder\n70:       ctx.fillStyle = \"#7df9ff\";\n71:       ctx.beginPath();\n72:       ctx.arc(player.x, player.y, player.radius, 0, Math.PI*2);\n73:       ctx.fill();\n74:       // Publish initial observable state\n75:       publishState();\n76:       startLoop();\n77:     }\n78: \n79:     // === LOOP/UPDATE =============================================================\n80:     // Animation loop handling\n81:     function startLoop() {\n82:       // Cancel any existing animation frame to avoid stacking loops\n83:       if (loopId !== null) cancelAnimationFrame(loopId);\n84:       function tick(now) {\n85:         try {\n86:           const dt = Math.min((now - lastTime) / 1000, 0.1);\n87:           lastTime = now;\n88:           // Clear canvas each frame\n89:           ctx.clearRect(0, 0, canvas.width, canvas.height);\n90:           // Basic render placeholder: draw player dot\n91:           ctx.fillStyle = \"#7df9ff\";\n92:           ctx.beginPath();\n93:           ctx.arc(player.x, player.y, player.radius, 0, Math.PI * 2);\n94:           ctx.fill();\n95:           // Publish observable state each frame\n96:           publishState();\n97:         } catch (err) {\n98:           console.error(\"loop error\", err);\n99:         }\n100:         loopId = requestAnimationFrame(tick);\n101:       }\n102:       loopId = requestAnimationFrame(tick);\n103:     }\n104: \n105:     // === RENDER =============================================================\n106:     // (to be implemented in later tasks)\n107: \n108:     // === INPUT =============================================================\n109:     // Keyboard tracking\n110:     document.addEventListener('keydown', ev => {\n111:       if (ev.key === 'r' || ev.key === 'R') { reset(); return; }\n112:       // Toggle radius on space\n113:       if (ev.key === ' ') {\n114:         player.targetRadius = (player.targetRadius === PLAYER_RADIUS_SMALL) ? PLAYER_RADIUS_LARGE : PLAYER_RADIUS_SMALL;\n115:         player.radius = player.targetRadius;\n116:       }\n117:       keys.add(ev.key);\n118:     });\n119:     document.addEventListener('keyup', ev => keys.delete(ev.key));\n120:     // Mouse / touch input for radius toggle\n121:     // Click or tap on the canvas toggles the player's radius\n122:     canvas.addEventListener('click', () => {\n123:       player.targetRadius = (player.targetRadius === PLAYER_RADIUS_SMALL) ? PLAYER_RADIUS_LARGE : PLAYER_RADIUS_SMALL;\n124:       player.radius = player.targetRadius;\n125:     });\n126:     canvas.addEventListener('touchstart', ev => {\n127:       ev.preventDefault();\n128:       player.targetRadius = (player.targetRadius === PLAYER_RADIUS_SMALL) ? PLAYER_RADIUS_LARGE : PLAYER_RADIUS_SMALL;\n129:       player.radius = player.targetRadius;\n130:     }, { passive: false });\n131:     // Restart button\n132:     restartBtn.addEventListener('click', reset);\n133: \n134:     // === AUDIO (lazy) =============================================================\n135:     // (to be implemented in later tasks)\n136: \n137:     // === OBSERVABLE CONTRACT ===============================================\n138:     function publishState() {\n139:       window.__game = {\n140:         state: phase,\n141:         score: score,\n142:         player: { x: player.x, y: player.y, visible: player.visible },\n143:         objective: 'Toggle the dot’s radius to match tunnel gaps as they scroll by.'\n144:       };\n145:     }\n146: \n147:     // === BOOT ===============================================================\n148:     // Initial setup\n149:     reset();\n150:   </script>\n151: </body>\n152: </html>\n\n(End of file - total 152 lines)\n</content>","metadata":{"preview":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>Scale Shift</title>\n  <style>\n    body { margin: 0; background: #0a0a0f; color: #e6e6f0; font-family: ui-sans-serif, system-ui, sans-serif; }\n    .game-header { padding: 12px 16px; border-bottom: 1px solid #1d1d2a; }\n    .game-header h1 { margin: 0; font-size: 18px; color: #7df9ff; }\n    .game-header .game-description { margin: 4px 0; color: #a5a5b8; }\n    .game-header .game-controls { margin: 4px 0; padding-left: 18px; color: #c8c8d8; }\n    main { display: flex; flex-direction: column; align-items: center; pa