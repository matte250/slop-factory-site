2:     // === CONFIG =============================================================\n33:     const W = 800, H = 600;\n34:     const PLAYER_R = 8;\n35:     const PLAYER_X = 200; // Fixed X screen position\n36:     const VERT_SPEED = 300; // vertical speed (px/sec)\n37:     const FORWARD_SPEED = 200; // world forward scroll speed (px/sec)\n38:     const SLIP_DISTANCE = 150; // distance added on time‑slip\n39:     const SLIP_COOLDOWN = 1.0; // seconds\n40:     const HAZARD_W = 30, HAZARD_H = 60;\n41:     const HAZARD_SPAWN_INTERVAL = 1.0; // seconds\n42:     const SAFE_RADIUS_AT_SPAWN = 120;\n43:     const SCORE_PER_HAZARD = 10;\n44: \n45:     // === STATE ==============================================================\n46:     const canvas = document.getElementById(\"game\");\n47:     const ctx = canvas.getContext(\"2d\");\n48:     const restartBtn = document.getElementById(\"restart\");\n49: \n50:     let player = { y: H / 2, vy: 0 };\n51:     let hazards = [];\n52:     let score = 0;\n53:     let highScore = 0;\n54:     let phase = \"menu\"; // \"menu\" | \"playing\" | \"gameover\"\n55:     let slipCooldown = 0;\n56:     let slipRequested = false;\n57:     let keys = new Set();\n58:     let lastTime = performance.now();\n59:     let loopId = null;\n60:     let audioCtx = null;\n61:     let distance = 0; // total forward distance traveled\n62:     let spawnTimer = 0;\n63: \n64:     function reset() {\n65:       player.y = H / 2;\n66:       player.vy = 0;\n67:       hazards = [];\n68:       score = 0;\n69:       phase = \"playing\";\n70:       slipCooldown = 0;\n71:       slipRequested = false;\n72:       keys.clear();\n73:       distance = 0;\n74:       spawnTimer = 0;\n75:       lastTime = performance.now();\n76:       publishState();\n77:       startLoop();\n78:     }\n79: \n80:     // === LOOP / UPDATE =====================================================\n81:     function startLoop() {\n82:       if (loopId !== null) cancelAnimationFrame(loopId);\n83:       function tick(now) {\n84:         try {\n85:           const dt = Math.min((now - lastTime) / 1000, 0.1);\n86:           lastTime = now;\n87:           update(dt);\n88:           render();\n89:           publishState();\n90:         } catch (err) {\n91:           console.error(\"loop error\", err);\n92:         }\n93:         loopId = requestAnimationFrame(tick);\n94:       }\n95:       loopId = requestAnimationFrame(tick);\n96:     }\n97: \n98:     function spawnHazard() {\n99:       const worldX = distance + W + Math.random() * 200;\n100:       const y = HAZARD_H / 2 + Math.random() * (H - HAZARD_H);\n101:       const playerWorldX = distance + PLAYER_X;\n102:       const dx = worldX - playerWorldX;\n103:       if (Math.abs(dx) < SAFE_RADIUS_AT_SPAWN) return;\n104:       hazards.push({ worldX, y });\n105:     }\n106: \n107:     function update(dt) {\n108:       if (phase !== \"playing\") return;\n109:       distance += FORWARD_SPEED * dt;\n110:       slipCooldown = Math.max(0, slipCooldown - dt);\n111:       let move = 0;\n112:       if (keys.has(\"ArrowUp\") || keys.has(\"w\") || keys.has(\"W\")) move -= 1;\n113:       if (keys.has(\"ArrowDown\") || keys.has(\"s\") || keys.has(\"S\")) move += 1;\n114:       player.vy = move * VERT_SPEED;\n115:       player.y += player.vy * dt;\n116:       if (player.y < PLAYER_R) player.y = PLAYER_R;\n117:       if (player.y > H - PLAYER_R) player.y = H - PLAYER_R;\n118:       if (slipRequested && slipCooldown <= 0) {\n119:         distance += SLIP_DISTANCE;\n120:         slipCooldown = SLIP_COOLDOWN;\n121:         beep(800, 0.08);\n122:         slipRequested = false;\n123:       } else {\n124:         slipRequested = false;\n125:       }\n126:       spawnTimer -= dt;\n127:       while (spawnTimer <= 0) {\n128:         spawnHazard();\n129:         spawnTimer += HAZARD_SPAWN_INTERVAL;\n130:       }\n131:       for (let i = hazards.length - 1; i >= 0; i--) {\n132:         const h = hazards[i];\n133:         const screenX = h.worldX - distance;\n134:         const dx = screenX - PLAYER_X;\n135:         const dy = h.y - player.y;\n136:         const rectHalfW = HAZARD_W / 2 + PLAYER_R;\n137:         const rectHalfH = HAZARD_H / 2 + PLAYER_R;\n138:         if (Math.abs(dx) < rectHalfW && Math.abs(dy) < rectHalfH) {\n139:           phase = \"gameover\";\n140:           if (score > highScore) highScore = score;\n141:           beep(110, 0.3);\n142:           break;\n143:         }\n144:         if (screenX + HAZARD_W / 2 < 0) {\n145:           hazards.splice(i, 1);\n146:           score += SCORE_PER_HAZARD;\n147:           beep(440, 0.04);\n148:         }\n149:       }\n150:     }\n151: \n152:     // === RENDER =============================================================\n153:     function render() {\n154:       ctx.fillStyle = \"#05050c\";\n155:       ctx.fillRect(0, 0, W, H);\n156:       ctx.fillStyle = \"#ff5252\";\n157:       for (const h of hazards) {\n158:         const screenX = h.worldX - distance;\n159:         ctx.fillRect(screenX - HAZARD_W / 2, h.y - HAZARD_H / 2, HAZARD_W, HAZARD_H);\n160:       }\n161:       ctx.fillStyle = \"#7df9ff\";\n162:       ctx.beginPath();\n163:       ctx.arc(PLAYER_X, player.y, PLAYER_R, 0, Math.PI * 2);\n164:       ctx.fill();\n165:       ctx.fillStyle = \"#e6e6f0\";\n166:       ctx.font = \"16px ui-sans-serif, system-ui\";\n167:       ctx.textAlign = \"left\";\n168:       ctx.fillText(`Score ${score}`, 12, 22);\n169:       if (phase === \"gameover\") {\n170:         ctx.fillStyle = \"rgba(5,5,12,0.65)\";\n171:         ctx.fillRect(0, 0, W, H);\n172:         ctx.textAlign = \"center\";\n173:         ctx.font = \"44px ui-sans-serif, system-ui\";\n174:         ctx.fillStyle = \"#ff52ae\";\n175:         ctx.fillText(\"Game Over\", W/2, H/2 - 20);\n176:         ctx.fillStyle = \"#e6e6f0\";\n177:         ctx.font = \"20px ui-sans-serif, system-ui\";\n178:         ctx.fillText(`Final score ${score}`, W/2, H/2 + 14);\n179:         ctx.fillStyle = \"#a5a5b8\";\n180:         ctx.font = \"16px ui-sans-serif, system-ui\";\n181:         ctx.fillText(\"Press R or click Restart\", W/2, H/2 + 42);\n182:       }\n183:     }\n184: \n185:     // === INPUT ==============================================================\n186:     document.addEventListener(\"keydown\", (ev) => {\n187:       if (ev.key === \"r\" || ev.key === \"R\") { reset(); return; }\n188:       if (ev.key === \" \" || ev.key === \"Space\") { slipRequested = true; ev.preventDefault(); }\n189:       keys.add(ev.key);\n190:     });\n191:     document.addEventListener(\"keyup\", (ev) => { keys.delete(ev.key); });\n192:     restartBtn.addEventListener(\"click\", reset);\n193:     canvas.addEventListener(\"click\", () => { slipRequested = true; });\n194: \n195:     // === AUDIO (lazy) ======================================================\n196:     function beep(freq, durSec) {\n197:       try {\n198:         if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();\n199:         const osc = audioCtx.createOscillator();\n200:         const gain = audioCtx.createGain();\n201:         osc.type = \"triangle\";\n202:         osc.frequency.value = freq;\n203:         gain.gain.setValueAtTime(0.04, audioCtx.currentTime);\n204:         gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + durSec);\n205:         osc.connect(gain);\n206:         gain.connect(audioCtx.destination);\n207:         osc.start();\n208:         osc.stop(audioCtx.currentTime + durSec);\n209:       } catch {}\n210:     }\n211: \n212:     // === OBSERVABLE CONTRACT ===============================================\n213:     function publishState() {\n214:       window.__game = {\n215:         state: phase,\n216:         score,\n217:         player: { x: PLAYER_X, y: player.y, visible: player.y >= 0 && player.y < H },\n218:         objective: \"Advance the dot forward through a scrolling tunnel, using time‑slips strategically.\"\n219:       };\n220:     }\n221: \n222:     // === BOOT ===============================================================\n223:     function publishInitialState() {\n224:       window.__game = {\n225:         state: \"menu\",\n226:         score: 0,\n227:         player: { x: PLAYER_X, y: H/2, visible: true },\n228:         objective: \"Tap to create a time‑slip that moves the dot forward while the tunnel scrolls.\"\n229:       };\n230:     }\n231:     publishInitialState();\n232:     reset();\n233:   </script>\n234: </body>\n235: </html>\n\n(End of file - total 235 lines)\n</content>","metadata":{"preview":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>Chrono Skip</title>\n  <style>\n    body { margin: 0; background: #0a0a0f; color: #e6e6f0; font-family: ui-sans-serif, system-ui, sans-serif; }\n    .game-header { padding: 12px 16px; border-bottom: 1px solid #1d1d2a; }\n    .game-header h1 { margin: 0; font-size: 18px; color: #7df9ff; }\n    .game-header .game-description { margin: 4px 0; color: #a5a5b8; }\n    .game-header .game-controls { margin: 4px 0; padding-left: 18px; color: #c8c8d8; }\n    main { display: flex; flex-direction: column; align-items: center; padding: 16px; }\n    canvas { background: #05050c; border: 1px solid #2a2f44; }\n    .game-restart { margin-top: 10px; padding: 8px 14px; background: #1c2030; color: #7df9ff; border: 1px solid #2a2f44; cursor: pointer; }\n    .game-restart:hover { background: #232842; }\n  </style>\n</head>\n<body>\n  <header class=\"game-header\">\n    <h1>Chrono Skip</h1>","truncated":false,"loaded":[]},"title":"tmp/slop-factory-work/chrono-skip-0b412b1c/index.html","time":{"start":1778504895046,"end":1778504895063}},"id":"prt_e172704e1001dS5h2UsJxBvnzZ","sessionID":"ses_1e8efc4e3ffecgrvDTbB2a04x0","messageID":"msg_e1726e052001lIbSjz16cjkGrD"}}
