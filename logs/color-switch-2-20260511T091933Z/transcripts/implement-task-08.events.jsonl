===================================================\n93:     // Input handling: track pressed keys and handle reset.\n94:     document.addEventListener('keydown', (ev) => {\n95:       // Map R/r key to reset, others to keys set.\n96:       if (ev.key === 'r' || ev.key === 'R') {\n97:         // Call reset if defined.\n98:         if (typeof reset === 'function') reset();\n99:         return;\n100:       }\n101:       keys.add(ev.key);\n102:     });\n103:     document.addEventListener('keyup', (ev) => {\n104:       keys.delete(ev.key);\n105:     });\n106:     // Restart button click triggers reset.\n107:     restartBtn.addEventListener('click', () => {\n108:       if (typeof reset === 'function') reset();\n109:     });\n110:     \n111:     </script>\n112: </body>\n113: </html>\n\n(End of file - total 113 lines)\n</content>","metadata":{"preview":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>Color Switch</title>\n  <style>\n    body { margin: 0; background: #0a0a0f; color: #e6e6f0; font-family: ui-sans-serif, system-ui, sans-serif; }\n    .game-header { padding: 12px 16px; border-bottom: 1px solid #1d1d2a; }\n    .game-header h1 { margin: 0; font-size: 18px; color: #7df9ff; }\n    .game-header .game-description { margin: 4px 0; color: #a5a5b8; }\n    .game-header .game-controls { margin: 4px 0; padding-left: 18px; color: #c8c8d8; }\n    main { display: flex; flex-direction: column; align-items: center; padding: 16px; }\n    canvas { background: #0f1320; border: 1px solid #2a2f44; }\n    .game-restart { margin-top: 10px; padding: 8px 14px; background: #1c2030; color: #7df9ff; border: 1px solid #2a2f44; cursor: pointer; }\n    .game-restart:hover { background: #232842; }\n  </style>\n</head>\n<body>\n  <header class=\"game-header\">\n    <h1>Color Switch</h1>","truncated":false,"loaded":[]},"title":"tmp/slop-factory-work/color-switch-2-01a94000/index.html","time":{"start":1778490488503,"end":1778490488520}},"id":"prt_e164b3271001sNUf